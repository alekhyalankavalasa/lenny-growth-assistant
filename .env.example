# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=lenny_secret_key_change_me_in_prod
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Selection
# Options: ollama, openai, anthropic
LLM_PROVIDER=ollama
LLM_FALLBACK_TO_OLLAMA=true
CLOUD_MODEL=claude-sonnet-4-5

# Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Ollama Settings (Local fallback)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Postgres Database (Used by docker-compose)
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_secret
POSTGRES_DB=lenny_db
DATABASE_URL=postgresql+asyncpg://lenny:lenny_secret@db:5432/lenny_db

# Backend server
BACKEND_PORT=8000
